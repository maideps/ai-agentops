# Copy to .env and pass it explicitly (uv run uvicorn ... --env-file .env).
# Settings read only real environment variables; tests never read .env.
APP_ENV=development
LOG_LEVEL=INFO
# mock | replay | hosted_free | live_paid; hosted_free and live_paid also need ENABLE_LIVE_LLM=true
LLM_MODE=mock
ENABLE_LIVE_LLM=false
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1
MAX_LLM_CALLS_PER_RUN=6
MAX_TOOL_CALLS_PER_RUN=8
MAX_GRAPH_STEPS=16
MAX_RUN_SECONDS=90
MAX_OUTPUT_TOKENS=500
MAX_REQUESTS_PER_DEMO_USER=5
DATABASE_URL=postgresql://agentops:change-me@127.0.0.1:55432/agentops
# Read-only analytics login used by the workflow (row-level security applies).
ANALYTICS_DATABASE_URL=postgresql://agentops_analytics:change-me-analytics@127.0.0.1:55432/agentops
# Tool gateway login: reads plus approvals, sandbox tickets and the policy log.
APP_DATABASE_URL=postgresql://agentops_app:change-me-app@127.0.0.1:55432/agentops
LANGFUSE_ENABLED=false
# Phase 1 demo identity for POST /v1/runs/{run_id}/feedback; empty token = feedback disabled.
DEMO_API_TOKEN=
DEMO_TENANT_ID=demo-a
DEMO_USER_ID=user-a-analyst
# Provider and tracing keys: set them in your shell or secret store, never in a committed file.
# GOOGLE_API_KEY
# GROQ_API_KEY
# LANGFUSE_PUBLIC_KEY
# LANGFUSE_SECRET_KEY
